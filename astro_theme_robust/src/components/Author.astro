---
import '../styles/author.css';
import { author } from '../config';
---

<section class="sidebar">
  <header>AUTHOR</header>
  <div class="author">
    {author.thumbnail && (
      <div class="author-thumb" style={`background-image: url(${author.thumbnail});`}></div>
    )}
    <div class="author-name">{author.name}</div>
    <ul class="author-facts">
      {author.facebook && (
        <li><a href={author.facebook} rel="noopener nofollow" target="_blank"><i class="fa-brands fa-facebook" aria-hidden="true"></i></a></li>
      )}
      {author.twitter && (
        <li><a href={author.twitter} rel="noopener nofollow" target="_blank"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a></li>
      )}
      {author.github && (
        <li><a href={author.github} rel="noopener nofollow" target="_blank"><i class="fa-brands fa-github" aria-hidden="true"></i></a></li>
      )}
    </ul>
    <div class="author-description" set:html={author.description}></div>
  </div>
</section>
