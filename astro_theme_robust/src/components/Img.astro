---
// src/components/Img.astro
const { src, caption, href, width, height, class: className } = Astro.props;
---

<figure class={className}>
  <img 
    src={src} 
    alt={caption} 
    width={width} 
    height={height}
  />
  
  {caption && (
    <figcaption>
      {href ? (
        <a href={href} rel="noopener" target="_blank">{caption}</a>
      ) : (
        caption
      )}
    </figcaption>
  )}
</figure>
