---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
---

<aside class="share">
  <a href={`https://b.hatena.ne.jp/my/add.confirm?url=${encodeURIComponent(url)}`} title="はてなブックマーク" class="ht" target="_blank" rel="noopener nofollow">B!</a>
  <a href={`https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`} title="Share on X" class="tw" target="_blank" rel="noopener nofollow"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
  <a href={`https://www.facebook.com/sharer.php?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}`} title="Facebook Share" class="fb" target="_blank" rel="noopener nofollow"><i class="fa-brands fa-facebook" aria-hidden="true"></i></a>
  <a href={`https://getpocket.com/edit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`} title="Save to Pocket" class="pk" target="_blank" rel="noopener nofollow"><i class="fa-brands fa-get-pocket" aria-hidden="true"></i></a>
  <a href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`} title="LINE Share" class="ln" target="_blank" rel="noopener nofollow"><i class="fa-brands fa-line" aria-hidden="true"></i></a>
</aside>
